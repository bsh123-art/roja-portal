<?xml version="1.0" encoding="utf-8"?>
<config>
    <fields name="params">
        <fieldset name="basic" label="COM_ROJACOMMENTS_FIELDSET_BASIC">
            <field name="enabled" type="radio" default="1" class="btn-group btn-group-yesno" label="COM_ROJACOMMENTS_ENABLE_COMMENTS" description="COM_ROJACOMMENTS_ENABLE_COMMENTS_DESC">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field name="allow_guest_comments" type="radio" default="1" class="btn-group btn-group-yesno" label="COM_ROJACOMMENTS_ALLOW_GUEST_COMMENTS" description="COM_ROJACOMMENTS_ALLOW_GUEST_COMMENTS_DESC">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field name="require_login" type="radio" default="0" class="btn-group btn-group-yesno" label="COM_ROJACOMMENTS_REQUIRE_LOGIN" description="COM_ROJACOMMENTS_REQUIRE_LOGIN_DESC">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field name="moderate_new_comments" type="radio" default="1" class="btn-group btn-group-yesno" label="COM_ROJACOMMENTS_MODERATE_NEW_COMMENTS" description="COM_ROJACOMMENTS_MODERATE_NEW_COMMENTS_DESC">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field name="max_comment_length" type="number" default="2000" min="100" max="10000" label="COM_ROJACOMMENTS_MAX_COMMENT_LENGTH" description="COM_ROJACOMMENTS_MAX_COMMENT_LENGTH_DESC" />
            <field name="comments_per_page" type="number" default="20" min="5" max="100" label="COM_ROJACOMMENTS_COMMENTS_PER_PAGE" description="COM_ROJACOMMENTS_COMMENTS_PER_PAGE_DESC" />
            <field name="max_reply_depth" type="number" default="2" min="1" max="5" label="COM_ROJACOMMENTS_MAX_REPLY_DEPTH" description="COM_ROJACOMMENTS_MAX_REPLY_DEPTH_DESC" />
            <field name="enable_recommend" type="radio" default="1" class="btn-group btn-group-yesno" label="COM_ROJACOMMENTS_ENABLE_RECOMMEND" description="COM_ROJACOMMENTS_ENABLE_RECOMMEND_DESC">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field name="enable_report" type="radio" default="1" class="btn-group btn-group-yesno" label="COM_ROJACOMMENTS_ENABLE_REPORT" description="COM_ROJACOMMENTS_ENABLE_REPORT_DESC">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field name="enable_share" type="radio" default="1" class="btn-group btn-group-yesno" label="COM_ROJACOMMENTS_ENABLE_SHARE" description="COM_ROJACOMMENTS_ENABLE_SHARE_DESC">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field name="enable_reader_picks" type="radio" default="1" class="btn-group btn-group-yesno" label="COM_ROJACOMMENTS_ENABLE_READER_PICKS" description="COM_ROJACOMMENTS_ENABLE_READER_PICKS_DESC">
                <option value="1">JYES</option>
                <option value="0">JNO</option>
            </field>
            <field name="close_after_days" type="number" default="0" min="0" max="3650" label="COM_ROJACOMMENTS_CLOSE_AFTER_DAYS" description="COM_ROJACOMMENTS_CLOSE_AFTER_DAYS_DESC" />
            <field name="allowed_categories" type="Category" extension="com_content" multiple="true" default="" label="COM_ROJACOMMENTS_ALLOWED_CATEGORIES" description="COM_ROJACOMMENTS_ALLOWED_CATEGORIES_DESC" />
        </fieldset>
    </fields>
</config>
