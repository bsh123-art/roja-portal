<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="5.0" method="upgrade">
    <name>com_rojacomments</name>
    <creationDate>2026-09-16</creationDate>
    <author>ROJA Portal</author>
    <authorEmail>dev@roja.local</authorEmail>
    <authorUrl>https://roja.example</authorUrl>
    <copyright>Copyright (C) ROJA Portal</copyright>
    <license>GPL-2.0-or-later</license>
    <version>1.0.0</version>
    <description>ROJA Comments component for Joomla article discussion.</description>
    <namespace path="src">Roja\Component\Rojacomments</namespace>

    <administration>
        <menu img="class:comment" link="index.php?option=com_rojacomments">ROJA Comments</menu>
        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <filename>services.php</filename>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
        </files>
    </administration>

    <files folder="site">
        <filename>services.php</filename>
        <folder>src</folder>
    </files>

    <media destination="com_rojacomments" folder="media">
        <folder>com_rojacomments</folder>
    </media>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
</extension>
