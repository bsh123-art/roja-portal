<?xml version="1.0" encoding="UTF-8"?>
<extension type="template" client="site" method="upgrade">
  <name>roja_portal</name>
  <version>2.2.10</version>
  <creationDate>2026-09</creationDate>
  <author>ROJA Portal</author>
  <description>ROJA Portal v2 - standalone editorial portal template for Joomla 6.</description>
  <inheritable>0</inheritable>
  <files>
    <filename>index.php</filename>
    <filename>component.php</filename>
    <filename>error.php</filename>
    <filename>offline.php</filename>
    <filename>templateDetails.xml</filename>
    <folder>html</folder>
    <folder>language</folder>
  </files>
  <media destination="templates/site/roja_portal" folder="media">
    <folder>css</folder>
    <folder>js</folder>
  </media>
  <positions>
    <position>topbar</position>
    <position>header-tools</position>
    <position>menu</position>
    <position>search</position>
    <position>breaking-news</position>
    <position>banner-top</position>
    <position>hero-main</position>
    <position>hero-side</position>
    <position>trending</position>
    <position>latest-main</position>
    <position>latest-sidebar</position>
    <position>category-1</position>
    <position>category-2</position>
    <position>category-3</position>
    <position>category-4</position>
    <position>editors-pick</position>
    <position>banner-middle</position>
    <position>newsletter</position>
    <position>breadcrumbs</position>
    <position>sidebar-left</position>
    <position>sidebar-right</position>
    <position>main-top</position>
    <position>main-bottom</position>
    <position>footer-about</position>
    <position>footer-menu-1</position>
    <position>footer-menu-2</position>
    <position>footer-social</position>
    <position>footer-bottom</position>
    <position>debug</position>
  </positions>
  <config>
    <fields name="params">
      <fieldset name="brand" label="TPL_ROJA_BRAND_LAYOUT">
        <field name="logoFile" type="media" relative="true" default="" label="TPL_ROJA_LOGO" />
        <field name="siteTitle" type="text" default="ROJA PORTAL" label="TPL_ROJA_SITE_TITLE" filter="string" />
        <field name="siteDescription" type="text" default="Berita • Edukasi • Kopi • Teknologi" label="TPL_ROJA_TAGLINE" filter="string" />
        <field name="accent" type="color" default="#c62026" label="TPL_ROJA_ACCENT_COLOR" />
        <field name="stickyHeader" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="TPL_ROJA_STICKY_HEADER"><option value="0">JNO</option><option value="1">JYES</option></field>
        <field name="homeComponent" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="TPL_ROJA_HOME_COMPONENT"><option value="0">JNO</option><option value="1">JYES</option></field>
        <field name="backTop" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="TPL_ROJA_BACK_TO_TOP"><option value="0">JNO</option><option value="1">JYES</option></field>
      </fieldset>
      <fieldset name="comments" label="TPL_ROJA_ARTICLE_COMMENTS">
        <field name="commentsEnabled" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="TPL_ROJA_ENABLE_DISQUS" description="TPL_ROJA_DISQUS_ENABLE_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
        <field name="disqusShortname" type="text" default="" label="TPL_ROJA_DISQUS_SHORTNAME" filter="string" maxlength="63" description="TPL_ROJA_DISQUS_SHORTNAME_DESC" />
        <field name="commentsHeading" type="text" default="" label="TPL_ROJA_COMMENTS_HEADING_LABEL" filter="string" maxlength="120" />
      </fieldset>
    </fields>
  </config>
</extension>
